# App
APP_ENV=local
APP_NAME=Decime UY
APP_LOCALE_DEFAULT=es-UY-montevideo

# OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_AUDIO=audio

# Backend
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Auth (VM / production — off by default for local dev)
AUTH_ENABLED=false
AUTH_JWT_SECRET=change-me-in-production
AUTH_DATABASE_PATH=data/decime.db
AUTH_JWT_EXPIRE_MINUTES=10080
AUTH_ALLOW_REGISTRATION=false
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# Text (translate / understand / training): OpenAI or OpenAI-compatible API via LangChain
LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_TEXT_BASE_URL=   # optional: DeepSeek/Groq/etc. OpenAI-compatible endpoint
LLM_ORCHESTRATOR=langchain
# LangSmith tracing — off by default.
# LLM_TRACING_ENABLED=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=decime-eval-pilot
# LANGSMITH_HIDE_IO=true
# Prompt versions. local keeps today's checked-in templates and does not call LangSmith.
# DECIME_PROMPT_SOURCE=local
# DECIME_PROMPT_ENV=production
# DECIME_PROMPT_PINS=
# DECIME_PROMPT_SNAPSHOT_DIR=
# DECIME_CODE_REVISION=
# EVAL_MODEL_A=gpt-5.6-luna
# EVAL_MODEL_B=gpt-6-luna
# EVAL_JUDGE_MODEL=gpt-5-mini
# LLM_TRACING_ALLOW_PRODUCTION=false
# Audio: Whisper STT + Orpheus TTS (Ollama hosts the Orpheus voice model only — not text LLM)
OLLAMA_BASE_URL=http://localhost:11434
STT_PROVIDER=faster_whisper
WHISPER_MODEL_SIZE=tiny
WHISPER_CPU_THREADS=2
WHISPER_NUM_WORKERS=1
TTS_PROVIDER=orpheus

# Orpheus TTS — Orpheus-FastAPI on :5005, model in Ollama — see docs/orpheus_tts_setup.md
ORPHEUS_TTS_BASE_URL=http://localhost:5005
ORPHEUS_TTS_VOICE=javi
ORPHEUS_TTS_MODEL=orpheus
ORPHEUS_OLLAMA_MODEL=sematre/orpheus:it_es

# Frontend (Next.js public)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# PostgreSQL (VM / production — enables persistent storage + required auth)
# DATABASE_URL=postgresql://decime:decime@localhost:5432/decime
# Web: NEXT_PUBLIC_API_BASE_URL. Production APK bakes api.decime.online.
# Dev/LAN APK: set API URL in Diagnostics (scan or manual), not in Settings.

# Dictionary ↔ n8n / Google Sheets (server-side only; never put in NEXT_PUBLIC_*)
# N8N_EXPORT_WEBHOOK_URL=http://n8n:5678/webhook/decime/dictionary/export
# N8N_IMPORT_WEBHOOK_URL=http://n8n:5678/webhook/decime/dictionary/import
# N8N_AUTOMATION_KEY=
# GOOGLE_DICTIONARY_SPREADSHEET_ID=
# DICTIONARY_SHEETS_JOB_TIMEOUT_MINUTES=30

# Twilio / Palabra — out of scope (see docs/out_of_scope.md)
