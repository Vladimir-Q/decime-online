# Copy to deploy/.env — decime.online production

POSTGRES_USER=decime
POSTGRES_PASSWORD=change-me
POSTGRES_DB=decime

PUBLIC_WEB_URL=https://decime.online
PUBLIC_API_URL=https://api.decime.online

APP_ENV=production
AUTH_ENABLED=true
AUTH_JWT_SECRET=change-me-min-32-chars-random-secret
AUTH_ALLOW_REGISTRATION=false
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@decime.online
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong

CLOUDFLARE_TUNNEL_TOKEN=

# Text (translate, understand, training) — OpenAI / OpenAI-compatible via LangChain
LLM_PROVIDER=openai
LLM_ORCHESTRATOR=langchain
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
# OPENAI_TEXT_BASE_URL=   # optional compatible endpoint

# --- Recommended: edge speech on your PC (Tailscale) ---
# See docs/edge_speech_tailscale.md — set EDGE_SPEECH_HOST and use
# docker-compose.local-ai.edge.yml (no VM ollama/orpheus).
EDGE_SPEECH_HOST=
# Overlay fills these from EDGE_SPEECH_HOST; uncomment only if overriding manually:
# STT_PROVIDER=openai
# OPENAI_STT_BASE_URL=http://100.64.x.x:8090/v1
# OPENAI_STT_MODEL=whisper-small
# TTS_PROVIDER=orpheus
# ORPHEUS_TTS_BASE_URL=http://100.64.x.x:5005
# OLLAMA_BASE_URL=http://100.64.x.x:11434
ORPHEUS_TTS_VOICE=javi
ORPHEUS_OLLAMA_MODEL=sematre/orpheus:it_es

# Edge mode disables Docker AI control (speech is on the PC).
AI_DOCKER_CONTROL_ENABLED=false
AI_DOCKER_PROJECT=decime

# --- Alternative: in-VM local AI (not recommended on small shared VMs) ---
# Leave EDGE_SPEECH_HOST empty and use local-ai.yml + eco.yml.
# STT_PROVIDER=faster_whisper
# WHISPER_MODEL_SIZE=base
# WHISPER_CPU_THREADS=2
# WHISPER_NUM_WORKERS=1
# TTS_PROVIDER=orpheus
# AI_DOCKER_CONTROL_ENABLED=true

# Text LLM is OpenAI only. Do not set LLM_PROVIDER=ollama in production.
# Ollama (edge or in-VM) is only the Orpheus TTS backend (ORPHEUS_OLLAMA_MODEL).

# --- Dictionary export/import via n8n + Google Sheets (server-side only) ---
# Attach API to the n8n Docker network with docker-compose.n8n-net.yml.
# Callbacks from n8n use http://decime-api:8000/api/v1 (Header Auth).
# N8N_EXPORT_WEBHOOK_URL=http://n8n:5678/webhook/decime/dictionary/export
# N8N_IMPORT_WEBHOOK_URL=http://n8n:5678/webhook/decime/dictionary/import
# N8N_AUTOMATION_KEY=generate-a-long-random-secret
# GOOGLE_DICTIONARY_SPREADSHEET_ID=your-shared-spreadsheet-id
# DICTIONARY_SHEETS_JOB_TIMEOUT_MINUTES=30
# DICTIONARY_SHEETS_MAX_IMPORT_ROWS=5000
