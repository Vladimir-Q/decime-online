FROM node:20-alpine AS builder

WORKDIR /app

ARG NEXT_PUBLIC_API_BASE_URL=http://localhost
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV DOCKER_BUILD=1

COPY apps/web/package.json apps/web/package-lock.json ./apps/web/
WORKDIR /app/apps/web
RUN npm ci

COPY apps/web/ ./
RUN npm run build

FROM alpine:3.20 AS export
COPY --from=builder /app/apps/web/out /out
# nginx service mounts this volume via a one-shot copy pattern in compose
CMD ["cp", "-r", "/out/.", "/export/"]
