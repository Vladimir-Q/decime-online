{
  "name": "decime-web",
  "version": "2.5.6",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cap": "cross-env CAPACITOR_BUILD=1 NEXT_PUBLIC_CAPACITOR_BUILD=1 NEXT_PUBLIC_API_BASE_URL=https://api.decime.online next build",
    "build:cap:dev": "cross-env CAPACITOR_BUILD=1 NEXT_PUBLIC_CAPACITOR_BUILD=1 next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build:cap && npx cap sync android",
    "cap:sync:dev": "npm run build:cap:dev && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npm run cap:sync && npx cap run android",
    "cap:apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "cap:apk:dev": "npm run cap:sync:dev && cd android && gradlew.bat assembleDebug",
    "cap:icons": "py ../../scripts/generate_android_icons.py"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/clipboard": "^7.0.4",
    "@capacitor/core": "^7.2.0",
    "@capacitor/preferences": "^7.0.1",
    "@capacitor/share": "^7.0.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "typescript": "^5.7.0"
  }
}
